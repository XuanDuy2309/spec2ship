{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2ship.dev/schemas/task.schema.json",
  "title": "Spec2Ship task plan (planning/tasks.json) - source for the Harness Plans.md section",
  "type": "object",
  "required": ["schema_version", "project", "phases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "tasks"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "requirement_ids", "layer", "dod", "depends"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
                "title": { "type": "string", "minLength": 1 },
                "requirement_ids": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^REQ-[A-Z0-9]{2,12}-\\d{3}$" }
                },
                "no_requirement_reason": { "type": "string" },
                "layer": { "enum": ["frontend", "backend", "api", "database", "infra", "test", "docs", "setup"] },
                "files": { "type": "array", "items": { "type": "string" } },
                "dod": { "type": "string", "minLength": 3 },
                "depends": { "type": "array", "items": { "type": "string", "pattern": "^\\d+\\.\\d+$" } },
                "tags": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^(tdd:required|tdd:skip:[a-z0-9-]+|feature:[a-z0-9-]+|bugfix:[a-z0-9-]+|skip:tdd|needs-spike)$" }
                },
                "risk": { "enum": ["destructive-migration", "breaking-api", "cross-repo", "security"] },
                "criteria_ids": { "type": "array", "items": { "type": "string", "pattern": "^AC-[A-Z0-9]{2,12}-\\d{3}-\\d{2}$" } }
              }
            }
          }
        }
      }
    }
  }
}
