{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec2ship.dev/schemas/requirement.schema.json",
  "title": "Spec2Ship requirements file (analysis/requirements.json)",
  "type": "object",
  "required": ["schema_version", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string" },
    "source_documents": { "type": "array", "items": { "type": "string" } },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["document"],
      "additionalProperties": false,
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "section": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "block_ids": { "type": "array", "items": { "type": "string", "pattern": "^B\\d{4,}$" } },
        "quote": { "type": "string" }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "given", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[A-Z0-9]{2,12}-\\d{3}-\\d{2}$" },
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "then": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["observed", "inferred"] }
      }
    },
    "ambiguity": {
      "type": "object",
      "required": ["id", "question", "blocking"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^Q-\\d{3}$" },
        "question": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["ambiguity", "conflict", "missing"] },
        "blocking": { "type": "boolean" },
        "evidence": { "type": "string" },
        "resolution": { "type": ["string", "null"] }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "type", "priority", "source", "description", "acceptance_criteria", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[A-Z0-9]{2,12}-\\d{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["functional", "non_functional", "ui", "data", "api", "security", "constraint"] },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "layers": {
          "type": "array",
          "items": { "enum": ["frontend", "backend", "api", "database", "infra"] }
        },
        "source": { "$ref": "#/$defs/source" },
        "description": { "type": "string", "minLength": 1 },
        "business_rules": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
        "status": {
          "enum": ["extracted", "analyzed", "mapped", "approved", "in_progress", "implemented", "verified", "blocked", "deferred", "rejected"]
        },
        "origin": { "enum": ["observed", "inferred"] },
        "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/ambiguity" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
